# Environment Variables
# Copy this file to .env.local and fill in the values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Admin credentials (used in CredentialsProvider)
ADMIN_EMAIL=koundinyapidaparthy@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# Email (SMTP) for contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=koundinyapidaparthy@gmail.com
SMTP_PASS=your-gmail-app-password

# Email for visitor tracking notifications (uses Gmail App Password)
EMAIL_FROM=koundinyapidaparthy@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Optional: TanStack Query / Analytics
NEXT_PUBLIC_GA_ID=
