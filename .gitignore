# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
cypress/screenshots/
cypress/videos/
cypress/downloads/

# local pipeline / form-intelligence data (keep resume source files tracked for CI)
/data/*
!/data/resume.json
!/data/resume.ts
!/data/index.ts

# next.js
/.next/
/out/

# production
/build

# static GitHub Pages export (CI only)
/dist

# misc
.DS_Store
*.pem

# CI/local Playwright apply recordings
/artifacts/

# pipeline cron logs
/logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# pipeline apply recording fallback (CI only)
/artifacts/

# cypress credentials (keep out of source control)
cypress.env.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python scraper runtime
__pycache__/
*.pyc
run_log.txt
.tmp/
