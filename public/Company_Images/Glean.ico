.nav-demo-cta-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 4rem; /* Match card’s border radius */
  padding: 0.25rem;
  overflow: hidden;
  transition: all 300ms ease;
}
#nav-get-demo-desktop, #nav-get-demo-mobile {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0.625rem 2rem;
  background: #343bed;
  color: white;
  border-radius: 4rem;
  line-height: 160%;
  overflow: hidden;
  transition: all 300ms ease;
}
/* Gradient Border */
.nav-demo-cta-wrapper::after {
  content: "";
  width: 40%;
  height: 500%;
  position: absolute;
  z-index: -2;
  padding: 0.25rem;
  border-radius: 4rem;
  background: linear-gradient(180deg, #d8fd49, #dcbb9b, #e16bff);
  animation: 4s spin linear infinite;
  transition: all 300ms ease;
}
/* White Border Blinks */
.nav-demo-cta-wrapper::before {
  content: "";
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: -1;
  padding: 0.25rem;
  border-radius: 4rem;
  background: white;
  animation: blink 4s ease-in-out infinite;
  transition: all 300ms ease;
}
/* Inside Arrow */
#nav-get-demo-desktop::before, #nav-get-demo-mobile::before {
  content: "";
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: 1;
  background-image: url("https://cdn.prod.website-files.com/6127a84dfe068e153ef20572/67dbd452d5406b3628313edc_CTA%20BG.svg");
  background-size: cover;
  background-position: center;
  animation: move 4s ease-in-out infinite;
  transition: all 300ms ease;
}
@keyframes spin {
  0% {
    transform: rotate(0deg);
    background: linear-gradient(180deg, #d8fd49, #dcbb9b, #e16bff);
    opacity: 0;
  }
  10% {
    transform: rotate(0deg);
    background: linear-gradient(180deg, #d8fd49, #dcbb9b, #e16bff);
    opacity: 1;
  }
  50% {
    transform: rotate(270deg);
    background: linear-gradient(180deg, #d8fd49, #dcbb9b, #e16bff);
    opacity: 1;
  }
  51%,
  99% {
    transform: rotate(270deg);
    background: linear-gradient(180deg, #e16bff, #e16bff, #e16bff);
    opacity: 1;
  }
  100% {
    transform: rotate(270deg);
    background: linear-gradient(180deg, #e16bff, #e16bff, #e16bff);
    opacity: 0;
  }
}
@keyframes blink {
  0%,
  50% {
    opacity: 0;
  }
  60% {
    opacity: 1;
  }
  70% {
    opacity: 0;
  }
  80% {
    opacity: 1;
  }
  90% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
@keyframes move {
  0%,
  80% {
    transform: translateX(-100%);
  }
  81% {
    transform: translateX(-100%);
  } /* Animation happens here */
  100% {
    transform: translateX(100%);
  } /* Holds position for the remaining time */
}
</style></div></div></div><div class="hide-desktop"><div class="nav-demo-cta-wrapper"><a id="nav-get-demo-mobile" aria-label="" data-event="navbar_get-demo_mobile-click" data-category="Navbar" href="/get-a-demo" class="button-24 w-inline-block"><div class="z-index-1">Get a demo</div></a></div></div></div><div id="nav-mobile-menu-icon" class="nav-25_mobile_menu-icon"><div class="mobile-nav_icon_line-top"></div><div class="mobile-nav_icon_line-middle"><div class="menu-icon_line-middle-inner"></div></div><div class="mobile-nav_icon_line-bottom"></div></div></div></div></div><div id="nav-mobile-menu" class="nav-25_mobile-menu"><div class="page-padding hide-desktop"><div class="nav-25_container"><div class="nav-25_left-wrap"><a id="nav-brand-link" href="/" class="brand-link w-inline-block"><img width="100" height="40" alt="Glean Logomark Blue" src="https://cdn.prod.website-files.com/6127a84dfe068e153ef20572/66ded1bc82df72f2e1d56eb7_Glean%20Logomark%20Blue.svg" loading="lazy"/></a></div><div class="nav-25_right-wrap"><div class="navbar-buttons"><div class="hide-tablet"><a id="nav-sign-in-desktop" aria-label="Sign into Glean" data-event="" data-category="" data-label="" href="https://app.glean.com/login?redirect=%2F" target="_blank" class="button-24 is-secondary w-button">Sign in </a></div><div class="hide-tablet"><a id="nav-get-demo-desktop" aria-label="" data-event="" data-wf--button-24---blue-bg--variant="base" href="/get-a-demo" class="button-24 w-button">Get a demo</a></div><div class="hide-desktop"><a id="nav-get-demo-mobile" aria-label="" data-event="" data-wf--button-24---blue-bg--variant="base" href="/get-a-demo" class="button-24 w-button">Get a demo</a></div></div><div class="nav-25_mobile-menu_close w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
