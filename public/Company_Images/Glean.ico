<link href="https://www.glean.com/404" rel="canonical"></div><div class="page_wrapper"><div class="global-styles w-embed"><style>

/* Get rid of top margin on first element in any rich text element */
.w-richtext > :not(div):first-child, .w-richtext > div:first-child > :first-child {
  margin-top: 0 !important;
}

/* Get rid of bottom margin on last element in any rich text element */
.w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
	margin-bottom: 0 !important;
}

.shadow-xxsmall {
  box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.04); !important;
}

.shadow-xsmall {
  box-shadow: 0px 2px 10px 0px rgba(0, 0, 0, 0.1); !important;

}

.shadow-small {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.shadow-medium {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;
}

.home-team-slider {
	box-shadow: 0px 0px 24px rgba(0, 0, 0, 0.02);
}

.button {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.button:hover {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;}
 
 .button.is-secondary {
  box-shadow: 0px 0px 0px 0px rgba(5, 7, 53, 0.16); !important;
}
.button.is-big {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.button.is-big:hover {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;
}

.button.is-big.is-secondary {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.button.is-big.is-secondary:hover {
  box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;
}

.button.is-big.is-secondary:focus {
  box-shadow: 0px 0px 0px 0px rgba(5, 7, 53, 0.24); !important;
}

.button.is-alternate {
	box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.button.is-alternate:hover  {
	box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;
}

.button.is-big.is-alternate {
	box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.16); !important;
}

.button.is-big.is-alternate:hover {
	box-shadow: 0px 1px 8px 0px rgba(5, 7, 53, 0.24); !important;
}

.button.is-link {
	box-shadow: none !important;
}

.button.is-link:hover {
	box-shadow: none !important;
}

.navbar-link:hover {
	color: #343CED !important;
}

.navbar-scroll {
  box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.04); !important;
	border-bottom: 1px solid transparent;
  transition: box-shadow 0.25s ease-in-out;
}

/* Highlight Effect Starts */
.highlight-container, .highlight {
  position: relative;
}

.highlight-container {
  display: inline-block;
}

/* Line Height Variations */
.highlight-container.large-style:before{
	height: 30%;
  padding-right: 9px;
  
}

.highlight-container.medium-style:before{
	height: 25%;
  padding-right: 7px;

}

.highlight-container.small-style:before{
	height: 20%;
  padding-right: 3px;
  margin-left: -1px;
  margin-right: -2px;
}
/* Highlight Effect Ends */

.overview-hero-image {
box-shadow: (0px 0px 40px rgba(0, 0, 0, 0.2));
}

.security-image-mobile{
filter: drop-shadow(0px 0px 22.8168px rgba(0, 0, 0, 0.25));
}

.solution-hero-image{
filter: drop-shadow(0px 4px 40px rgba(255, 255, 255, 0.4));
}

.demo-quote-wrapper{
box-shadow: 0px 0px 24px 0px rgba(0, 0, 0, 0.02);
}
</style>

<style>
  .flb::after{
      content: "\a";
      white-space: pre;
  }
</style>

<style>

.w-lightbox-backdrop {
	background-color: rgba(93, 99, 241, 0.97);
}
.w-lightbox-close{
	background-image: url(https://cdn.prod.website-files.com/6402260e1be34eb7d6a24570/6402260e1be34ec5c2a24855_Close.svg);
	display: inline-block;
  max-width: 100%;
  vertical-align: middle;
}

.border-radius-0-25 {
	-webkit-mask-image: -webkit-radial-gradient(white, black);
}

.resources-card {
	-webkit-mask-image: -webkit-radial-gradient(white, black);
}

