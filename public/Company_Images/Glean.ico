<!-- OSANO CSS - STARTS -->
<style>
	.osano-cm-window{
  	font-family: Polysans Slim, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: 0.5px;
  }
  .osano-cm-dialog--type_bar.osano-cm-dialog--position_bottom {
    bottom: 1.5rem;
    left: 1.5rem;
    max-width: 24rem;
    display: flex;
    flex-direction: column;
    align-content: flex-start;
    border-radius: 1rem;
    align-items: flex-start;
    gap: 1rem;
  }
  @media screen and (min-width: 768px) {
    .osano-cm-dialog--type_bar .osano-cm-dialog__buttons {
      margin: 0rem;
      max-width: none;
      min-width: 100%;
      width: 100%;
    }
    .osano-cm-dialog--type_bar .osano-cm-button {
      margin: 0.25rem 0rem;
    }
	}
  .osano-cm-button {
    padding-top: 0.75rem;
    padding-right: 1.5rem;
    padding-bottom: 0.75rem;
    padding-left: 1.5rem;
    background-color: #FFFFFF;
    border-radius: 4rem;
    border-color: #ffffff;
    color: #ffffff;
    font-size: 1rem;
    background: transparent;
    white-space: nowrap
  }
  .osano-cm-button:hover {
    /* background-color: #D8FD49;
    border-color: #D8FD49; */
    color: #343CED;
    background: #FFFFFF;
  }
  .osano-cm-dialog--type_bar .osano-cm-dialog__buttons {
  	/*max-width: 10rem;
    min-width: 5rem;*/
  }
  .osano-cm-link {
  	font-size: 1rem;
  	color: #ffffff;
  }
  .osano-cm-link:hover {
  	color: #fff;
  }
  .osano-cm-info-dialog-close {
  	background-color: #343CED;
    color: #FFFFFF;
  }
  .osano-cm-usage-list {
  	margin: 0.5rem 0 .5em;
    font-size: 1em;
    line-height: 1.25;
    color: #fff;
  }
  .osano-cm-list-item {
    margin: 0.5rem 0rem;
    font-size: 0.875rem;
  }
  .osano-cm-usage-list__list {
    list-style: none;
    padding-left: 0;
    margin-top: 0.5rem;
  }
  .osano-cm-list__list-item::before {
    content: "•"; /* Or any symbol you want */
    display: inline-block;
    color: white; /* Customize as needed */
  }
  #osano-cm-dialog-toggle-group .osano-cm-usage-list__list {
    list-style: none;
    padding-left: 0;
    margin-top: 0rem;
  }
  #osano-cm-dialog-toggle-group .osano-cm-list__list-item::before {
    content: ""; /* Or any symbol you want */
    display: none;
    color: white; /* Customize as needed */
  }
  #osano-cm-dialog-toggle-group .osano-cm-list-item {
    margin: 0rem 0rem;
  }
  .osano-cm-toggle__input:checked + .osano-cm-toggle__switch {
  	background-color: #E1DFD7;
    border-color: #E1DFD7;
  }
  .osano-cm-toggle__switch {
  	background-color: #E1DFD7;
    border-color: #E1DFD7;
    width: 28px !important;
    height: 14px;
  }
  
  .osano-cm-toggle__switch:before {
  	border-style: none;
  }
  .osano-cm-toggle__switch::after {
  	background-color: #777867;
    border-color: #777867;
    height: 14px;
    width: 14px;
  }
  
  .osano-cm-toggle__input:checked + .osano-cm-toggle__switch::after {
  	background-color: #343CED;
    border-color: #343CED
  }
  
  .osano-cm-toggle__input:checked + .osano-cm-toggle__switch {
  	background-color: #E1DFD7;
    border-color: #E1DFD7
  }
  
  .osano-cm-toggle__input:checked:hover + .osano-cm-toggle__switch {
  	background-color: #E1DFD7;
    border-color: #E1DFD7
  }

  .osano-cm-toggle__label {
    color: #ffffff;
  }
  .osano-cm-dialog__list .osano-cm-label {
  	margin-left: 0.5rem;
  }
  .osano-cm-toggle__label {
  	margin: 0 2rem 0 0;
  }
  .osano-cm-description:first-child, 
  .osano-cm-drawer-item p {
  	font-size: 0.875rem;
    line-height: 1.4;
  }
  .osano-cm-description:first-child {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }
  .osano-cm-disclosure__toggle {
  	color: #343CED;
    font-size: 0.875rem;
  }
  .osano-cm-disclosure__toggle:hover {
  	text-decoration: underline;
    color: #343CED;
  }
  .osano-cm-drawer-toggle .osano-cm-label {
  	color: black;
    font-size: 1rem;
  }
  .osano-cm-header, .osano-cm-info-dialog-header {
    font-family: Polysans Median, sans-serif;
    font-size: 1.125rem;
    background: #ffffff;
    background: linear-gradient(180deg, #ffffff 2.5em, #ffffff 100%);
  }
  .osano-cm-info-dialog-header:first-child {
  	border-bottom: 1px #0000001f solid;
  }
  .osano-cm-save.osano-cm-button {
  	color: #343CED;
    font-size: 1rem;
    background: #D8FD49;
  }
  .osano-cm-save.osano-cm-button:hover {
  	background: #C2FF9E
  }
  .osano-cm-powered-by .osano-cm-link {
  	font-size: 0.875rem;
    color: #00000075;
  }
  .osano-cm-powered-by .osano-cm-link:hover {
    color: #000000ba;
  }
  .osano-cm-dialog__close {
  	color: background;
  }
  .osano-cm-dialog__close {
    right: 0.25rem;
    top: 0.25rem;
  }
  @media screen and (max-width: 768px) {
  	.osano-cm-button {
      padding-top: 0.75rem;
      padding-right: 1rem;
      padding-bottom: 0.75rem;
      padding-left: 1rem;
    }
    .osano-cm-dialog--type_bar .osano-cm-dialog__buttons {
    	max-width: none;
    }
    .osano-cm-denyAll.osano-cm-button,
    .osano-cm-accept-all.osano-cm-button,
    .osano-cm-save.osano-cm-button{
    	width: 30%;
      font-size: 0.875rem;
    }
    .osano-cm-accept.osano-cm-button,
    .osano-cm-deny.osano-cm-button {
			width: 48%;
      font-size: 0.875rem;
    }
    .osano-cm-manage.osano-cm-button {
      width: 34%;
      font-size: 0.875rem;
      white-space: pre-wrap;
    }
    .osano-cm-view--active .osano-cm-save.osano-cm-button{
    	width: 100%;
    }
    .osano-cm-dialog--type_bar .osano-cm-dialog__list .osano-cm-label {
    	font-size: 0.875rem;
    }
   	.osano-cm-dialog--type_bar.osano-cm-dialog--position_bottom {
      bottom: 0rem;
      left: 0rem;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-content: flex-start;
      border-radius: 0rem;
      align-items: flex-start;
      gap: 0rem;
    }
  }
</style>
<!-- OSANO CSS - ENDS -->

