<!-- NAVBAR STARTS -->
<script>
  const navbar = document.querySelector('.navbar-25_component');

  window.addEventListener('scroll', function () {
    if (window.scrollY > 100) {
      navbar.classList.add('navbar-scroll');
    } else {
      navbar.classList.remove('navbar-scroll');
    }
  });
</script>

<!-- Nav Desktop Dropdown JS STARTS -->
<script>
  const triggers = document.querySelectorAll('.nav-25_list_item');
  const background = document.querySelector('.nav-25_dropdown-bg');
  const nav = document.querySelector('.nav-25_middle_wrap');

  function handleEnter() {
    this.classList.add('trigger-enter');
    setTimeout(() => {
      if (this.classList.contains('trigger-enter')) {
        this.classList.add('trigger-enter-active');
        background.style.display = 'block'; // Show background
      }
    }, 150);

    const dropdown = this.querySelector('.nav-25_dpdown');
    const dropdownCoords = dropdown.getBoundingClientRect();
    const navCoords = nav.getBoundingClientRect();

    const coords = {
      height: dropdownCoords.height,
      width: dropdownCoords.width,
      top: dropdownCoords.top - navCoords.top,
      left: dropdownCoords.left - navCoords.left,
    };

    background.style.setProperty('width', `${coords.width}px`);
    background.style.setProperty('height', `${coords.height}px`);
    background.style.setProperty(
      'transform',
      `translate(${coords.left}px, ${coords.top}px)`
    );

    // Add new classes for styling the toggle
    const toggle = this.querySelector('.nav-25_dpdown-toggle');
    const icon = this.querySelector('.nav-25_dpdown-toggle_icon');

    if (toggle) toggle.classList.add('toggle-active');
    if (icon) icon.classList.add('icon-rotated');
  }

  function handleLeave(e) {
    const relatedTarget = e.relatedTarget; // Where the cursor is moving to
    const dropdown = this.querySelector('.nav-25_dpdown');

    // If the cursor is still inside the dropdown, don't hide
    if (dropdown && dropdown.contains(relatedTarget)) return;

    this.classList.remove('trigger-enter', 'trigger-enter-active');

    // Hide the background only if the cursor is outside both trigger and dropdown
    setTimeout(() => {
      if (!document.querySelector('.trigger-enter')) {
        background.style.display = 'none';
      }
    }, 150);

    // Remove new classes when leaving
    const toggle = this.querySelector('.nav-25_dpdown-toggle');
    const icon = this.querySelector('.nav-25_dpdown-toggle_icon');

    if (toggle) toggle.classList.remove('toggle-active');
    if (icon) icon.classList.remove('icon-rotated');
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('pointerenter', handleEnter);
    trigger.addEventListener('pointerleave', handleLeave);
  });

  document.querySelectorAll('.nav-25_dpdown').forEach((dropdown) => {
    dropdown.addEventListener('pointerleave', function (e) {
      const relatedTarget = e.relatedTarget; // Where the cursor is moving to

      // If the cursor moves back to a trigger, keep it open
      if (relatedTarget && relatedTarget.closest('.nav-25_list_item')) return;

      // Otherwise, close everything
      document.querySelectorAll('.trigger-enter').forEach((el) => {
        el.classList.remove('trigger-enter', 'trigger-enter-active');
      });
      background.style.display = 'none';
    });
  });
</script>
<!-- Nav Desktop Dropdown JS ENDS -->

<!-- Nav Mobile Side Pane STARTS -->
<script>
  $(document).ready(function () {
    const menu = $('#nav-mobile-menu');
    const menuIcon = $('#nav-mobile-menu-icon');
    const sidePane = $('.nav-25_mobile-menu_side-pane');
    const openButtons = {
      '#nav-mobile-product-toggle': '#nav-mobile-product-pane',
      '#nav-mobile-solutions-toggle': '#nav-mobile-solutions-pane',
      '#nav-mobile-resources-toggle': '#nav-mobile-resources-pane',
    };
    const backButton = $('#nav-mobile-back');
    const closeButtons = $('.nav-25_mobile-menu_close'); // Updated: Select all close buttons

    // Open full menu with fade-in, but keep side pane hidden
    menuIcon.on('click', function () {
      menu.css('display', 'block').animate({ opacity: '1' }, 300);
      sidePane.css({ left: '102%', opacity: '0', display: 'none' }); // Ensure side pane remains hidden
    });

    // Open side pane and show corresponding content
    $.each(openButtons, function (button, pane) {
      $(button).on('click', function () {
        // Hide only content panes while keeping `.nav-25_mobile-menu_top` visible
        sidePane.children().not('.nav-25_mobile-menu_top').hide();
        $(pane).show(); // Show only the relevant content pane
        sidePane
          .css('display', 'block')
          .animate({ left: '0%', opacity: '1' }, 300);
      });
    });

    // Close side pane and return to original state
    backButton.on('click', function () {
      sidePane.animate({ left: '102%', opacity: '0' }, 300, function () {
        sidePane.css('display', 'none');
      });
    });

    // Close full menu with fade-out when any close button is clicked
    closeButtons.on('click', function () {
      // Updated: Now applies to all close buttons
      sidePane.animate({ left: '102%', opacity: '0' }, 300, function () {
        sidePane.css('display', 'none');
        menu.animate({ opacity: '0' }, 300, function () {
          menu.css('display', 'none');
        });
      });
    });
  });
</script>
<!-- Nav Mobile Side Pane ENDS -->

<!-- Nav Mobile Height Fix STARTS -->
<script>
  setTimeout(() => {
    let navbarBanner = document.querySelector('.navbar_banner');
    // if (!navbarBanner) {
    // console.error("DEBUG: .navbar_banner not found.");
    // return;
    // }

    let navbarHeightPx = navbarBanner.offsetHeight;
    // console.log("DEBUG: Navbar height in px:", navbarHeightPx);

    let rootFontSize = parseFloat(
      getComputedStyle(document.documentElement).fontSize
    );
    let bannerHeightRem = navbarHeightPx / rootFontSize;
    // console.log("DEBUG: Navbar height in rem:", bannerHeightRem);

    let mobileMenu = document.querySelector('.nav-25_mobile-menu');
    let panes = document.querySelectorAll(
      '.nav-25_mobile-menu_product-pane, .nav-25_mobile-menu_solutions-pane, .nav-25_mobile-menu_resources-pane'
    );

    // if (!mobileMenu) {
    // console.error("DEBUG: .nav-25_mobile-menu not found.");
    // return;
    // }

    // Update height for .nav-25_mobile-menu
    let newMobileMenuHeight = `calc(100dvh - ${bannerHeightRem}rem)`;
    // console.log("DEBUG: New height for .nav-25_mobile-menu:", newMobileMenuHeight);
    mobileMenu.style.height = newMobileMenuHeight;

    // Update height & min-height for panes
    panes.forEach((pane) => {
      let currentHeight = getComputedStyle(pane).height;
      let currentMinHeight = getComputedStyle(pane).minHeight;

      let updatedHeight = `calc(${currentHeight} - ${bannerHeightRem}rem)`;
      let updatedMinHeight = `calc(${currentMinHeight} - ${bannerHeightRem}rem)`;

      // console.log(`DEBUG: Updating ${pane.className} height: ${updatedHeight}, min-height: ${updatedMinHeight}`);

      pane.style.height = updatedHeight;
      pane.style.minHeight = updatedMinHeight;
    });

    // Add back navbar height when close button is clicked
    let closeButton = document.querySelector('.navbar_banner_close');

    // if (!closeButton) {
    // console.error("DEBUG: .navbar_banner_close not found.");
    // return;
    // }

    closeButton.addEventListener('click', () => {
      // console.log("DEBUG: navbar_banner_close clicked");

      // Reset height for .nav-25_mobile-menu
      let resetMobileMenuHeight = `calc(${
        getComputedStyle(mobileMenu).height
      } + ${bannerHeightRem}rem)`;
      // console.log("DEBUG: Resetting .nav-25_mobile-menu height:", resetMobileMenuHeight);
      mobileMenu.style.height = resetMobileMenuHeight;

      // Reset height & min-height for panes
      panes.forEach((pane) => {
        let currentHeight = getComputedStyle(pane).height;
        let currentMinHeight = getComputedStyle(pane).minHeight;

        let resetHeight = `calc(${currentHeight} + ${bannerHeightRem}rem)`;
        let resetMinHeight = `calc(${currentMinHeight} + ${bannerHeightRem}rem)`;

        // console.log(`DEBUG: Resetting ${pane.className} height: ${resetHeight}, min-height: ${resetMinHeight}`);

        pane.style.height = resetHeight;
        pane.style.minHeight = resetMinHeight;
      });
    });
  }, 2000); // Wait for elements to load
</script>
<!-- Nav Mobile Height Fix ENDS -->

