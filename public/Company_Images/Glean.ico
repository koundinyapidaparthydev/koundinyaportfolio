<!-- GLEAN SEARCH BOX - STARTS -->
<style>
  /* Start hidden, then fade in */
  #glean_search_component {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  #glean_search_component.is-visible {
    opacity: 1;
  }
</style>

<script
  defer
  src="https://glean-public-external.glean.com/embedded-search-latest.min.js"
></script>

<script defer>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search-box');
    const container = document.getElementById('glean_search_component');
    if (!input) {
      // console.error('Missing #search-box element');
      return;
    }

    // Configure External Search backend + which sources to show in the modal
    const backend = 'https://glean-public-external-be.glean.com';
    const datasourcesFilter = [
      'glean',
      'blogs',
      'webjjldruagleancommunity',
      'web_7',
      'web_6',
      'web_8',
    ];

    let authProvider;

    // Fade-in helper: runs once attach is successful
    const showComponent = () => {
      if (!container) return;
      // Force reflow to ensure transition runs when we add the class
      container.offsetHeight;
      container.classList.add('is-visible');
    };

    // onAuthTokenRequired callback: must return a fresh token (Promise<string>)
    const refreshAuthToken = async () => {
      try {
        const token = await authProvider.createAuthToken();
        return token;
      } catch (err) {
        console.error('Failed to refresh auth token', err);
        return null;
      }
    };

    const attachWithToken = (authToken) => {
      if (!window.GleanWebSDK) {
        console.error('GleanWebSDK not available yet');
        return;
      }

      // Attach the modal to your input, with auto-auth + datasources + basic theming
      window.GleanWebSDK.attach(input, {
        backend,
        authToken,
        onAuthTokenRequired: refreshAuthToken,
        datasourcesFilter,
        enableActivityLogging: true,
        disableAssistant: true,
        chatOptions: false,
        searchBoxCustomizations: {
          placeholderText: 'Search',
          borderRadius: 4,
          fontSize: 14,
        },
        // Optional analytics hook:
        // onSearch: (query) => {
        //   console.log('Modal search:', query);
        // },
      });

      // Fade in only after the SDK is attached/initialized
      showComponent();
    };

    const init = async () => {
      try {
        if (!window.GleanWebSDK) {
          console.error('GleanWebSDK not ready in init()');
          return;
        }
        // Guest auth provider for External Search
        authProvider = window.GleanWebSDK.createGuestAuthProvider({ backend });
        const token = await authProvider.getAuthToken();
        if (!token) {
          console.error('Auth token was not fetched correctly.');
          return;
        }
        attachWithToken(token);
      } catch (err) {
        console.error('Initialization error:', err);
      }
    };

    // If SDK already loaded (e.g., cached), init immediately
    if (window.GleanWebSDK) {
      init();
      return;
    }

    // Otherwise, wait for the SDK to finish loading
    const sdkScript = document.querySelector(
      'script[src*="embedded-search-latest.min.js"]'
    );
    if (sdkScript) {
      // If the SDK dispatches a ready signal, listen for it
      window.addEventListener('glean:ready', () => init(), { once: true });

      // Fallback: if glean:ready isn’t dispatched, try init right after load
      sdkScript.addEventListener('load', () => {
        setTimeout(() => {
          if (window.GleanWebSDK) init();
        }, 0);
      });
    } else {
      console.error('Embedded Search SDK script tag not found');
    }
  });
</script>
<!-- GLEAN SEARCH BOX - ENDS -->

<!-- Code to Handle Marketo Form Osano Blocking Issue Starts-->
<script>
(function () {
  /* =========================
     CONFIG
  ========================== */
  var SUPPORT_EMAIL = "hello@glean.com"; // change if needed
  var FALLBACK_COPY_TITLE = "Enable Targeted Advertising cookies to use this form";
  var FALLBACK_COPY_TEXT  = "To load and submit this Marketo form, please enable Targeted Advertising cookies in your preferences. You can turn them off again any time.";
  var CHECK_AFTER_MS = [800, 1600, 2800]; // covers slow loads + modal injection
  var HIDE_SCOPE = "embed"; // "embed" (recommended) or "form"

  // ✅ NEW: wait for Marketo if it loads late (cookies accepted but script slow)
  var WAIT_FOR_MKTO_MAX_MS = 20000;
  var WAIT_FOR_MKTO_EVERY_MS = 300;
  var __mktoWaitTimer = null;

  /* =========================
     HELPERS
  ========================== */
  function marketoLoaded() {
    return typeof window.MktoForms2 !== "undefined";
  }

  // ✅ NEW: start a single watcher that re-runs gating when MktoForms2 appears
  function waitForMarketoThenUngate() {
    if (__mktoWaitTimer || marketoLoaded()) return;

    var start = Date.now();
    __mktoWaitTimer = setInterval(function () {
      if (marketoLoaded()) {
        clearInterval(__mktoWaitTimer);
        __mktoWaitTimer = null;
        gateMktoFormsInDom(); // remove fallback + show forms
        return;
      }
      if (Date.now() - start > WAIT_FOR_MKTO_MAX_MS) {
        clearInterval(__mktoWaitTimer);
        __mktoWaitTimer = null;
      }
    }, WAIT_FOR_MKTO_EVERY_MS);
  }

  function escapeHtml(str) {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function ensureFallbackStyles() {
    if (document.getElementById("mkto-cookie-fallback-styles")) return;
    var style = document.createElement("style");
    style.id = "mkto-cookie-fallback-styles";
    style.textContent = `
      .mkto-cookie-fallback{
        border: 1px solid rgba(0,0,0,.12);
        border-radius: 16px;
        padding: 20px;
        margin: 12px 0;
        background: rgba(0,0,0,.02);
      }
      .mkto-cookie-fallback__title{
        font-size: 18px;
        line-height: 1.3;
        font-weight: 600;
        margin-bottom: 6px;
      }
      .mkto-cookie-fallback__text{
        font-size: 14px;
        line-height: 1.5;
        opacity: .85;
        margin-bottom: 14px;
      }
      .mkto-cookie-fallback__actions{
        display:flex;
        gap:12px;
        align-items:center;
        flex-wrap:wrap;
      }
      .mkto-cookie-fallback__btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.12);
        text-decoration:none;
        cursor:pointer;
        font-size: 14px;
        line-height: 1;
      }
      .mkto-cookie-fallback__btn--primary{
        background: #D8FD49;
        color: #111;
        border-color: transparent;
      }
      .mkto-cookie-fallback__btn--ghost{
        background: transparent;
        color: inherit;
      }
      .mkto-cookie-fallback__note{
        font-size: 12px;
        opacity: .7;
        margin-top: 10px;
      }
    `;
    document.head.appendChild(style);
  }

  function buildFallback() {
    var wrap = document.createElement("div");
    wrap.className = "mkto-cookie-fallback";
    wrap.innerHTML =
      '<div class="mkto-cookie-fallback__title">' + escapeHtml(FALLBACK_COPY_TITLE) + '</div>' +
      '<div class="mkto-cookie-fallback__text">' + escapeHtml(FALLBACK_COPY_TEXT) + '</div>' +
      '<div class="mkto-cookie-fallback__actions">' +
        '<a href="#" class="mkto-cookie-fallback__btn mkto-cookie-fallback__btn--primary" data-open-cookies="1">Manage cookies</a>' +
      '</div>' +
      '<div class="mkto-cookie-fallback__note">After you save preferences, this page will refresh to load the form.</div>';
    return wrap;
  }

  function getHideTargetForForm(formEl) {
    if (HIDE_SCOPE === "form") return formEl;
    // Most Marketo embeds are inside a Webflow embed wrapper:
    return formEl.closest("div.w-embed.w-script") || formEl;
  }

  /* =========================
     CORE: ONLY TARGET ACTUAL MARKETO FORMS
     - works for modals because MutationObserver triggers when form enters DOM
  ========================== */
  function gateMktoFormsInDom() {
    ensureFallbackStyles();

    var forms = Array.from(document.querySelectorAll('form[id^="mktoForm_"]'));
    if (!forms.length) return; // ✅ prevents fallback anywhere else (e.g., navbar script embed)

    if (!marketoLoaded()) {
      // ✅ NEW: if Marketo loads late, we'll detect and ungate automatically
      waitForMarketoThenUngate();

      forms.forEach(function (formEl) {
        var target = getHideTargetForForm(formEl);

        if (!target.__mktoFallback) {
          var fb = buildFallback();
          target.insertAdjacentElement("beforebegin", fb);
          target.__mktoFallback = fb;
        }

        target.style.display = "none";
      });
    } else {
      forms.forEach(function (formEl) {
        var target = getHideTargetForForm(formEl);

        target.style.display = "";
        if (target.__mktoFallback) {
          target.__mktoFallback.remove();
          target.__mktoFallback = null;
        }
      });
    }
  }

  /* =========================
     OSANO: open drawer + reload on Save
     (based on your DOM: .osano-cm-save exists)
  ========================== */
  var reloadInFlight = false;
  function reloadSoon() {
    if (reloadInFlight) return;
    reloadInFlight = true;
    setTimeout(function () { window.location.reload(); }, 200);
  }

  function openOsanoDrawer() {
    if (window.Osano && window.Osano.cm && typeof window.Osano.cm.showDrawer === "function") {
      window.Osano.cm.showDrawer();
      return true;
    }
    // fallback: click widget / manage button
    var btn = document.querySelector(".osano-cm-widget, .osano-cm-manage, .osano-cm-button--type_manage");
    if (btn) { btn.click(); return true; }
    return false;
  }

  // Reload when user saves preferences in drawer
  document.addEventListener("click", function (e) {
    var t = e.target;

    if (t.closest && t.closest(".osano-cm-save")) {
      reloadSoon();
      return;
    }

    // optional: if your setup persists on close/accept/reject
    if (t.closest && (
      t.closest(".osano-cm-accept") ||
      t.closest(".osano-cm-deny") ||
      t.closest(".osano-cm-reject") ||
      t.closest(".osano-cm-close")
    )) {
      setTimeout(reloadSoon, 250);
      return;
    }
  }, true);

  // Fallback button → open drawer
  document.addEventListener("click", function (e) {
    var btn = e.target.closest && e.target.closest("[data-open-cookies]");
    if (!btn) return;
    e.preventDefault();
    openOsanoDrawer();
  });

  /* =========================
     INIT
  ========================== */
  window.addEventListener("load", function () {
    CHECK_AFTER_MS.forEach(function (ms) {
      setTimeout(gateMktoFormsInDom, ms);
    });
  });

  // ✅ This solves “not in DOM yet” (modals):
  // When the modal opens and Webflow injects the form placeholder into the DOM,
  // the observer fires and we run gating immediately.
  var obs = new MutationObserver(function () {
    clearTimeout(window.__mktoGateT);
    window.__mktoGateT = setTimeout(gateMktoFormsInDom, 150);
  });
  obs.observe(document.documentElement, { childList: true, subtree: true });

})();
</script>
<!-- Code to Handle Marketo Form Osano Blocking Issue Ends--><!--
<script>
document.addEventListener("DOMContentLoaded", function () {
  let currentQuery = undefined;
  let debounceTimer;
  const backend = "https://glean-public-external-be.glean.com";
  const datasourcesFilter = ['glean', 'blogs', 'devdocs', 'helpdocs']; // Add your desired datasources here

  console.log("script loaded!");

  function navigateToSearchPage(searchTerm) {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      console.log("Navigating to:", searchTerm);
      const searchURL = `/search?q=${encodeURIComponent(searchTerm)}`;
      window.location.href = searchURL;
    }, 300); // Adjust the debounce time as needed
  }

  function renderSearchResults(authToken) {
    const resultsElement = document.querySelector("#search-results");
    if (!resultsElement) {
      console.error("Search results element not found in the DOM.");
      return;
    }
    window.EmbeddedSearch.renderSearchResults(resultsElement, {
      onSearch: (query) => {
        console.log("Search from results:", query);
        currentQuery = query;
        renderSearchBox(authToken);
      },
      query: currentQuery,
      authToken: authToken,
      backend: backend,
      disableAnalytics: false,
      hideAutocomplete: false,
      datasourcesFilter: datasourcesFilter,
      onAuthTokenRequired: refreshAuthToken,
      enableActivityLogging: true,
      showInlineSearchBox: true,
      searchBoxCustomizations: {
        borderRadius: 4,
        fontSize: 14,
        placeholderText: "What are you looking for?",
      },
    });
  }

  function renderSearchBox(authToken) {
    const autocompleteElement = document.querySelector("#search-box");
    if (!autocompleteElement) {
      console.error("Search box element not found in the DOM.");
      return;
    }
    window.EmbeddedSearch.renderSearchBox(autocompleteElement, {
      onSearch: (query) => {
        console.log("Search from box:", query);
        currentQuery = query;
        renderSearchResults(authToken);
        navigateToSearchPage(query);
      },
      query: currentQuery,
      authToken: authToken,
      backend: backend,
      disableAnalytics: false,
      hideAutocomplete: false,
      datasourcesFilter: datasourcesFilter,
      onAuthTokenRequired: refreshAuthToken,
      enableActivityLogging: true,
      searchBoxCustomizations: {
        borderRadius: 4,
        fontSize: 14,
        placeholderText: "What are you looking for?",
      },
    });
  }

  const authProvider = window.EmbeddedSearch?.createGuestAuthProvider({
    backend,
  });

  const refreshAuthToken = () => {
    authProvider.createAuthToken().then((t) => {
      authToken = t;
      // console.log("Refreshed Auth Token:", authToken); // Debugging line
    });
  };

  authProvider?.getAuthToken().then((authToken) => {
    //console.log("Auth Token:", authToken); // Debugging line
    if (!authToken) {
      //console.error("Auth token is not fetched correctly.");
      return;
    }

    renderSearchBox(authToken);
  });
});
</script>
