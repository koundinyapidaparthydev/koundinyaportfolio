<script>
  qualified('handleEvents', function (name, data) {
    switch (name) {
      case 'Send LeanData BookIt URL':
        if (LDBookItChat.isLastActiveTab()) {
          var encodedURLParams = LDBookItChat.generateEncodedURLParamsQualified(data.field_values, data.field_values.leandata_bookit_chat_fields);    
          var fieldValues = {
            leandata_bookit_log_id: LDBookItChat.getUniqueId()
          };
          qualified('identify', fieldValues);
          LDBookItChat.startChatRouting(null, encodedURLParams);
        }
        break;
    }
  })
</script>
