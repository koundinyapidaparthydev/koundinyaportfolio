  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    gtag('consent', 'default', {
      'ad_storage':              'denied',
      'ad_user_data':            'denied',
      'ad_personalization':      'denied',
      'analytics_storage':       'denied',
      'functionality_storage':   'denied',
      'personalization_storage': 'denied',
      'security_storage':        'granted',
      'wait_for_update':         2000
    });
  </script>

  

  
  <script>
    (function (w) {
      w.mwConsentQueue = w.mwConsentQueue || {
        _q: [],
        _seen: [],     // every run() registration is also recorded here so we
                       // can re-evaluate on mid-session consent changes.
        decided: false,
        allowed: {}
      };

      // ---------- helpers ----------

      // Read consent via SNow's canonical Launch helper.
      // Returns { allowed, source } or null when checkGDPR isn't
      // yet defined (Launch still loading) or throws.
      //
      // checkGDPR(1) → Required      → our cat 1 (always true)
      // checkGDPR(2) → Functional    → our cat 2
      // checkGDPR(3) → Advertising   → our cat 3
      function readFromLaunch() {
        if (typeof w.checkGDPR !== 'function') return null;
        try {
          var allowed = {
            1: true,                       // Required is structurally always on
            2: !!w.checkGDPR(2),           // Functional / Performance
            3: !!w.checkGDPR(3)            // Advertising
          };
          return { allowed: allowed, source: 'launch:checkGDPR' };
        } catch (e) {
          return null;
        }
      }

      // Compare two allowed-maps; returns the categories newly granted
      // in `next` (i.e. present in `next` but absent in `prev`).
      function newlyGranted(prev, next) {
        var added = [];
        [1, 2, 3].forEach(function (c) {
          if (next[c] && !prev[c]) added.push(c);
        });
        return added;
      }

      // ---------- Google Consent Mode bridge ----------
      // Translate our 3-bucket model → GCM v2 storage flags and push
      // `gtag('consent', 'update', ...)`. Safe to call repeatedly:
      // gtag updates are idempotent and last-write-wins, so calling
      // on every flush() / update() is correct.
      //
      //   cat 2 (Functional)   → analytics_storage,
      //                          functionality_storage,
      //                          personalization_storage
      //   cat 3 (Advertising)  → ad_storage,
      //                          ad_user_data,
      //                          ad_personalization
      //   security_storage     → always granted (essential)
      function pushGtagConsentUpdate(allowed) {
        try {
          w.dataLayer = w.dataLayer || [];
          // Local gtag shim — MUST push `arguments` (an Arguments
          // object), NOT a plain Array. GTM's consent listener only
          // recognizes `arguments[0] === 'consent'` against a true
          // Arguments object; a literal [...] is treated as a regular
          // dataLayer event with no `event` key and silently ignored.
          // See: https://developers.google.com/tag-platform/gtagjs/reference#consent
          function gtag() { w.dataLayer.push(arguments); }
          var cat2 = !!(allowed && allowed[2]);
          var cat3 = !!(allowed && allowed[3]);
          var v2 = cat2 ? 'granted' : 'denied';
          var v3 = cat3 ? 'granted' : 'denied';
          gtag('consent', 'update', {
            'ad_storage':              v3,
            'ad_user_data':            v3,
            'ad_personalization':      v3,
            'analytics_storage':       v2,
            'functionality_storage':   v2,
            'personalization_storage': v2,
            'security_storage':        'granted'
          });

          // ---------- Microsoft Clarity consent bridge ----------
          // Clarity does NOT auto-honor Google Consent Mode v2.
          // Without an explicit clarity('consent', ...) call, Clarity
          // writes _clck/_clsk cookies and records sessions even when
          // analytics_storage is denied (verified via cookie audit on
          // stage: _clck/_clsk persisted under cat 2 = denied).
          //
          // Clarity is Functional/Analytics, so it follows cat 2.
          // Clarity loads via Bing UET (tag 136016557) inside GTM.
          // The stub below queues the consent signal before UET fires;
          // Clarity's main script replays window.clarity.q on init.
          // API ref: https://learn.microsoft.com/en-us/clarity/setup-and-installation/cookie-consent
          //   clarity('consent')        → grants (legacy form)
          //   clarity('consent', true)  → grants
          //   clarity('consent', false) → revokes
          try {
            w.clarity = w.clarity || function () {
              (w.clarity.q = w.clarity.q || []).push(arguments);
            };
            w.clarity('consent', cat2);
          } catch (e) { /* ignore */ }
        } catch (e) { /* ignore — GCM bridge must never break the page */ }
      }

      // ---------- public queue API ----------

      // Push a tag initializer.
      // - If no decision yet: queued.
      // - If already decided AND category permitted: runs immediately.
      // - In all cases recorded in _seen so a later upgrade can fire it.
      w.mwConsentQueue.run = function (category, fn) {
        var entry = { category: category, fn: fn, fired: false };
        w.mwConsentQueue._seen.push(entry);
        if (w.mwConsentQueue.decided) {
          if (w.mwConsentQueue.allowed[category] && !entry.fired) {
            entry.fired = true;
            try { fn(); } catch (e) { console.warn('[CMP] tag init failed', e); }
          }
        } else {
          w.mwConsentQueue._q.push(entry);
        }
      };

      // Convenience: register a tag that should fire if ANY of the listed
      // categories is granted (e.g. SNow's "checkGDPR(2) || checkGDPR(3)"
      // verbal rule for Bizible/GTM). The initializer is guaranteed to
      // run at most once across the union.
      w.mwConsentQueue.runIfAnyOf = function (cats, fn) {
        var fired = false;
        function once() {
          if (fired) return;
          fired = true;
          try { fn(); } catch (e) { console.warn('[CMP] tag init failed', e); }
        }
        cats.forEach(function (c) { w.mwConsentQueue.run(c, once); });
      };

      // First-time decision: drain initial queue + fire any matching seen entries.
      w.mwConsentQueue.flush = function (allowed, reason) {
        if (w.mwConsentQueue.decided) return;
        w.mwConsentQueue.decided = true;
        w.mwConsentQueue.allowed = allowed || { 1: true };
        w.mwConsentQueue.reason = reason || 'unknown';
        try {
          console.info('[CMP] decision flushed', {
            allowed: w.mwConsentQueue.allowed,
            reason: w.mwConsentQueue.reason
          });
        } catch (e) { /* ignore */ }
        // Bridge to Google Consent Mode BEFORE draining the queue so
        // GTM (which loads via the queue) sees an updated consent
        // state on its first dataLayer scan.
        pushGtagConsentUpdate(w.mwConsentQueue.allowed);
        var q = w.mwConsentQueue._q.splice(0);
        q.forEach(function (item) {
          if (w.mwConsentQueue.allowed[item.category] && !item.fired) {
            item.fired = true;
            try { item.fn(); } catch (e) { console.warn('[CMP] tag init failed', e); }
          }
        });
        try {
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({
            event: 'mw_consent_updated',
            consent_state: w.mwConsentQueue.allowed,
            consent_reason: w.mwConsentQueue.reason
          });
        } catch (e) { /* ignore */ }
      };

      // Mid-session upgrade: user accepted more categories than before.
      // Re-runs any _seen entries whose category just became permitted.
      // (Downgrades cannot un-execute already-running tags; vendors must
      // honor the dataLayer event to stop sending hits.)
      w.mwConsentQueue.update = function (allowed, reason) {
        if (!w.mwConsentQueue.decided) {
          // No prior decision yet — treat as first flush.
          return w.mwConsentQueue.flush(allowed, reason);
        }
        var prev = w.mwConsentQueue.allowed || { 1: true };
        var next = allowed || { 1: true };
        var added = newlyGranted(prev, next);
        w.mwConsentQueue.allowed = next;
        w.mwConsentQueue.reason = reason || w.mwConsentQueue.reason;
        try {
          console.info('[CMP] decision updated', {
            previous: prev, current: next, added: added, reason: w.mwConsentQueue.reason
          });
        } catch (e) { /* ignore */ }

        // Bridge to Google Consent Mode on EVERY update (upgrade and
        // downgrade). GTM-resident tags will start/stop firing
        // accordingly per Consent Mode v2 spec.
        pushGtagConsentUpdate(next);

        // Fire any seen entries that match newly-granted categories.
        if (added.length) {
          w.mwConsentQueue._seen.forEach(function (entry) {
            if (!entry.fired && next[entry.category]) {
              entry.fired = true;
              try { entry.fn(); } catch (e) { console.warn('[CMP] tag init failed', e); }
            }
          });
        }

        // Always surface the updated state for GTM/Launch listeners.
        try {
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({
            event: 'mw_consent_updated',
            consent_state: next,
            consent_reason: w.mwConsentQueue.reason
          });
        } catch (e) { /* ignore */ }
      };

      // ---------- bootstrap: read from Launch ----------

      function tryFlush(reason) {
        var r = readFromLaunch();
        if (r && !w.mwConsentQueue.decided) {
          w.mwConsentQueue.flush(r.allowed, reason || r.source);
          return true;
        }
        return false;
      }

      function tryUpdate(reason) {
        var r = readFromLaunch();
        if (!r) return false;
        if (!w.mwConsentQueue.decided) {
          w.mwConsentQueue.flush(r.allowed, reason || r.source);
        } else {
          w.mwConsentQueue.update(r.allowed, reason || (r.source + '_update'));
        }
        return true;
      }

      // Try immediately. Per the live-page probe, SNow's Launch defines
      // checkGDPR synchronously, so this usually succeeds at T+0ms.
      if (!tryFlush('launch:initial')) {
        // Launch not ready yet — poll briefly.
        var pollAttempts = 0;
        var pollId = setInterval(function () {
          if (tryFlush('launch:poll') || ++pollAttempts > 40) clearInterval(pollId);
        }, 100);
      }

      // ---------- Listener: dataLayer push (TrustArc fires here on Accept) ----------
      // TrustArc on this tenant pushes { event: 'cookie_prefs_set' } to
      // window.dataLayer when the user clicks Accept / saves prefs.
      // We monkey-patch dataLayer.push so we catch it regardless of when
      // dataLayer is initialized.
      (function wireDataLayerHook() {
        w.dataLayer = w.dataLayer || [];
        var origPush = w.dataLayer.push.bind(w.dataLayer);
        w.dataLayer.push = function () {
          var ret = origPush.apply(null, arguments);
          for (var i = 0; i < arguments.length; i++) {
            var item = arguments[i];
            if (item && typeof item === 'object') {
              var ev = item.event;
              if (ev === 'cookie_prefs_set' ||
                  ev === 'useractioncomplete' ||
                  ev === 'trustarc_cm_loaded') {
                // Defer slightly so TrustArc finishes writing the cookie
                // and Launch's data element re-evaluates checkGDPR.
                setTimeout(function () { tryUpdate('dl:' + ev); }, 0);
              }
            }
          }
          return ret;
        };
      })();

      // ---------- Safety net: 4s timeout ----------
      // If Launch never appears (CSP block, ad blocker, network error),
      // default to required-only. Site stays compliant; gated trackers
      // stay queued. This is the only fail-closed path we need now —
      // when Launch IS present, its `checkGDPR` is the authoritative
      // answer and handles geo/expressed/implied logic internally.
      setTimeout(function () {
        if (w.mwConsentQueue.decided) return;
        // One last chance: maybe Launch finished loading between the
        // last poll and now.
        if (tryFlush('launch:timeout_recovered')) return;
        console.warn('[CMP] Adobe Launch / checkGDPR unavailable after 4s — failing CLOSED (required only).');
        w.mwConsentQueue.flush({ 1: true }, 'timeout_launch_unavailable');

        // ---------- Late-arrival watcher (slow networks) ----------
        // We only get here when Launch's async <script> hasn't loaded
        // within 4s. For returning visitors with a valid TrustArc
        // cookie, no dataLayer event will ever fire later
        // (`cookie_prefs_set` only emits on an explicit Accept click)
        // — meaning GTM/VWO/Bizible/Marketo would stay queued forever
        // even after Launch eventually loads.
        //
        // Keep polling at 500ms for up to 30s. As soon as checkGDPR
        // appears we read it ONCE and stop, regardless of outcome:
        //   - grant cat 2/3 → update() drains _seen, fires GTM/etc.
        //                     and pushes gtag('consent','update')
        //   - required-only → update() confirms cat 1, no tags fire.
        // Stopping on first read avoids spamming duplicate
        // `mw_consent_updated` dataLayer events on every poll tick.
        // Late TrustArc Accept clicks are still handled by the
        // dataLayer monkey-patch above.
        var lateAttempts = 0;
        var lateWatchId = setInterval(function () {
          if (++lateAttempts > 60) {         // 60 * 500ms = 30s ceiling
            clearInterval(lateWatchId);
            return;
          }
          if (typeof w.checkGDPR !== 'function') return;
          clearInterval(lateWatchId);        // read once, then stop
          tryUpdate('launch:late_arrival');
        }, 500);
      }, 4000);
    })(window);
  </script>

  
  <script async type="text/javascript">
      var digitalData = {
  "page" : {
    "pageInfo" : {
      "pageName" : "www::content:moveworksprogram:us:en:errors",
      "canonicalPageName" : "www::content:moveworksprogram:us:en:errors",
      "pageCompleteURL" : "https://www.moveworks.com/us/en/errors",
      "cleanURL" : "https://www.moveworks.com/us/en/errors",
      "pageDomain" : "moveworks.com",
      "previousURL" : "na",
      "pageLoadTime" : "na",
      "timeParting" : "na",
      "pageErrorType" : "Error Page:404",
      "pageTags" : ""
    },
    "category" : {
      "primaryCategory" : "www::content:moveworksprogram:us:en",
      "canonicalCategory" : "www::content:moveworksprogram:us:en",
      "siteSection" : "errors",
      "hierarchyLevel1" : "errors",
      "hierarchyLevel2" : "na",
      "hierarchyLevel3" : "na",
      "hierarchyLevel4" : "na"
    },
    "attributes" : {
      "server" : "adobeaemcloud.com",
      "language" : "en",
      "urlQueryString" : "",
      "siteName" : "mw-us",
      "urlHash" : "na",
      "deviceType" : "na",
      "screenResolution" : "na",
      "screenOrientation" : "na",
      "userAgent" : "na",
      "MCID" : "na"
    },
    "linkClick" : {
      "link_text" : "",
      "link_title" : "",
      "link_panel_name" : "",
      "link_dest_url" : ""
    },
    "regform" : {
      "form_id" : "",
      "form_name" : "",
      "form_type" : "",
      "form_host" : "",
      "form_parentpage" : ""
    }
  },
  "event" : [ ]
};

      const marketingParams = (() => {
        const params = new URLSearchParams(window.location.search);

        const marketingKeys = [
          'utm_campaign',
          'utm_source',
          'utm_medium',
          'utm_term',
          'utm_content',
          'utm_keyword'
        ];

        const result = {};

        marketingKeys.forEach(key => {
          result[key] = params.get(key) || "na";
        });

        return result;
      })();

      digitalData.page.attributes.utmCampaign = marketingParams.utm_campaign;
      digitalData.page.attributes.utmContent = marketingParams.utm_content;
      digitalData.page.attributes.utmKeyword = marketingParams.utm_keyword;
      digitalData.page.attributes.utmMedium = marketingParams.utm_medium;
      digitalData.page.attributes.utmSource = marketingParams.utm_source;
      digitalData.page.attributes.utmTerm = marketingParams.utm_term;
      
      digitalData.page.attributes.fullUTM = [...Object.values(marketingParams)].join(":");

      window.addEventListener("DOMContentLoaded", ()=>{
      // previous page
      const referrer = document.referrer;
      digitalData.page.pageInfo.previousURL = referrer;
      // page load time
      const entries = performance.getEntriesByType("navigation");
      if (entries.length > 0) {
          digitalData.page.pageInfo.pageLoadTime = (entries[0].domContentLoadedEventEnd - entries[0].startTime) / 1000;
      }
      // url hash
      const hashValue = window.location.hash.substring(1);
      digitalData.page.attributes.urlHash = hashValue ? "#"+hashValue : '';
      // device type
      const ua = navigator.userAgent;
      digitalData.page.attributes.deviceType = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua) ?
                                               "Mobile" :
                                               /Tablet|iPad/i.test(ua) ?
                                               "Tablet" :
                                               "Desktop";
      digitalData.page.attributes.userAgent = ua;
      // Get screen width and height
      const screenWidth = screen.width;
      const screenHeight = screen.height;
      digitalData.page.attributes.screenResolution = screenWidth+"x"+screenHeight;
      // Get screen oriantation
      if(screen.orientation){
        digitalData.page.attributes.screenOrientation = screen.orientation.type;
      }
      // Get current time
      function getFormattedDateString() {
        const calendar = new Date(); // Create a new Date object
        const timeOptions = { hour: '2-digit', minute: '2-digit', hour12: true }; // Format options for time
        const dayOptions = { weekday: 'long' }; // Format options for the day

        // Get formatted time and day
        const formattedTime = calendar.toLocaleTimeString('en-US', timeOptions);
        const formattedDay = calendar.toLocaleDateString('en-US', dayOptions);

        return formattedTime+'|'+formattedDay;
      }
      digitalData.page.pageInfo.timeParting = getFormattedDateString();

      function getCleanUrl() {
        const url = new URL(window.location.href);
        url.search = ''; // Removes query parameters
        url.hash = '';   // Optional: removes hash if you want a truly clean URL
        return url.toString();
      }
      const pageTitle = document.title.toLocaleLowerCase();
      if(pageTitle.includes("404") || pageTitle.includes("not found") || pageTitle.includes("error")){
        digitalData.page.pageInfo.cleanURL = getCleanUrl();
        digitalData.page.pageInfo.pageCompleteURL = window.location.href;
      }
    })
    window.dataLayer = window.dataLayer || [];
  </script>

  
